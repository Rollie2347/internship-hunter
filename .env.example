# Copy this file to .env (same folder) and fill in real values.
# .env is gitignored -- never commit real secrets.

# Anthropic API key, from https://console.anthropic.com -- used in Phase 3 (people
# finder) and Phase 4 (drafting). Each API call costs a small amount of money.
ANTHROPIC_API_KEY=

# Path to the Gmail API OAuth client file you download from Google Cloud Console
# (APIs & Services > Credentials > Create OAuth client ID > Desktop app).
# Needed in Phase 4. Example: C:\Users\rro\Documents\internship-hunter\credentials.json
GOOGLE_OAUTH_CLIENT_SECRET_PATH=

# The Gmail account that Phase 4 will create drafts in. The student chose
# rro@theomalleyfamily.net (not the owner email below) for this.
GMAIL_DRAFT_ACCOUNT=rro@theomalleyfamily.net

# Owner email for the tool itself (identification only, e.g. for logs).
OWNER_EMAIL=snapreelmedia@gmail.com

# How many people a day the bot sends you to write to, on its own (email
# drafts + LinkedIn cards together). Nothing is ever sent for you: each one
# still needs your tap (email) or your own paste (LinkedIn).
OUTREACH_PER_DAY=10

# The hour they are sent, on this PC's clock (7 = 7 AM, 18 = 6 PM).
DAILY_RUN_HOUR=7

# Hard ceiling per day on email drafts + application cards, however many
# you ask for with /pitch or /more.
DAILY_DRAFT_CAP=25

# Telegram bot used for status updates TO the student (new postings, follow-up
# reminders, weekly "other routes" digest). Create a bot via @BotFather on
# Telegram to get a token; TELEGRAM_CHAT_ID is filled in automatically by
# `python -m internship_hunter.notify.cli fetch-chat-id` the first time, after
# you've sent the bot one message.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: a GitHub token (no scopes needed) raises the rate limit when the
# people finder checks PUBLIC GitHub profiles for a contact's published email.
GITHUB_TOKEN=

# Hard ceiling on LinkedIn cards per day (a search link + a note you paste
# yourself), however many you ask for with /linkedin.
LINKEDIN_DAILY_CAP=10

# How many companies a day the bot may web-search for people. 0 = never on its
# own. Each company costs noticeably more than reading a team page (searches
# are billed per search, plus the text of the results), so leave it at 0 and
# run `python -m internship_hunter.people.cli web --limit 3` by hand until you
# know what a run costs you.
WEB_PEOPLE_SEARCH_PER_DAY=0

# Optional: a Hunter.io API key (free plan). Used for Domain Search only --
# addresses Hunter saw published on a real page, stored with that page's URL.
# Its Email Finder (which guesses addresses) is never used.
# HUNTER_MONTHLY_LIMIT is how many searches a month the tool may spend; set
# it to what your plan shows at https://hunter.io/usage.
HUNTER_API_KEY=
HUNTER_MONTHLY_LIMIT=25
