.env
data/*
*.db
__pycache__/
.venv/
profile/resume.*
credentials.json
token.json
lever_out.json
*.log
.pytest_cache/

# The cloud scanner's own database IS committed on purpose -- it's how the
# GitHub Actions workflow remembers which postings it already saw, since each
# scheduled run starts from a fresh checkout. The PC's own tracker
# (data/tracker.db: applications, contacts, sent emails) is NOT in git.
!data/cloud_tracker.db
